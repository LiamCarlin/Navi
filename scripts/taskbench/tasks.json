      "utterance": "order me toilet paper on amazon. chepest possible",
      "expect": { "commands": 1, "kind": ["task"], "surface": ["browser"], "start_hosts": ["amazon.com"] },
      "live": { "safe_end": "cheapest toilet paper in the Amazon cart" } },
    { "id": "errand-03", "family": "errand", "source": "log 2026-10-30", "context": "chrome_google",
      "utterance": "order me a randome chipotle bowl",
      "expect": { "commands": 1, "kind": ["task"], "surface": ["browser"], "current_tab": false,
                  "start_hosts": ["chipotle.com", "doordash.com", "ubereats.com", "grubhub.com"] },
      "live": { "safe_end": "a bowl in the Chipotle bag" } },
    { "id": "errand-04", "family": "errand", "source": "log 2026-10-30", "context": "chrome_google",
