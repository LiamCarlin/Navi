{
  "version": 1,
  "about": "Navi task bench. Each task is something Liam says (real phrasings from agent-runs.log where marked 'log'), the screen it is said over (context), and what Navi's decision layer must decide — checkable without driving the screen. Expectations are the TARGET behaviour, not today's. Offline harness: NaviTests/TaskBenchTests.swift (scripts/taskbench/offline.sh). Live mode: scripts/taskbench/live.sh. Schema: docs/TASK_BENCH.md.",
  "contexts": {
    "desktop": { "front_app": "Finder", "front_bundle": "com.apple.finder", "title": "Downloads" },
    "chrome_google": { "front_app": "Google Chrome", "front_bundle": "com.google.Chrome", "url": "https://www.google.com/", "title": "Google" },
    "chrome_canvas": { "front_app": "Google Chrome", "front_bundle": "com.google.Chrome", "url": "https://canvas.olin.edu/courses/1079/modules", "title": "Modules: Applied Mathematics for Engineers MTH3180 Fall 2026" },
    "chrome_mcdonalds": { "front_app": "Google Chrome", "front_bundle": "com.google.Chrome", "url": "https://www.mcdonalds.com/us/en-us.html", "title": "McDonald's: Burgers, Fries & More. Quality Ingredients.",
      "recent": ["“Go to McDonald's” → Done: opened mcdonalds.com"], "last_was_browser": true },
    "chrome_doordash_store": { "front_app": "Google Chrome", "front_bundle": "com.google.Chrome", "url": "https://www.doordash.com/store/7th-street-burger-needham-2468/", "title": "7th Street Burger Delivery Menu | Needham - DoorDash",
      "recent": ["“order me a burger” → Ready for you to place the order — Navi never pays. Added Double Cheeseburger to the DoorDash cart"], "last_was_browser": true },
    "chrome_amazon_cart": { "front_app": "Google Chrome", "front_bundle": "com.google.Chrome", "url": "https://www.amazon.com/cart?ref_=ox_ewc_ret_gtc_dsk_us", "title": "Amazon.com Shopping Cart",
      "recent": ["“order me a burger” → Ready for you to place the order — Navi never pays. Added Double Cheeseburger to the DoorDash cart",
                 "“open my cart to see where I'm gonna pay” → Done: click Go to Cart (amazon.com)"], "last_was_browser": true },
    "notes_new": { "front_app": "Notes", "front_bundle": "com.apple.Notes", "title": "Notes",
      "recent": ["“make a new note called Student Spark that says hello class” → Completed in 2 steps: Press ⌘N · Type ‘Student Spark⏎hello class’"] },
    "music": { "front_app": "Music", "front_bundle": "com.apple.Music", "title": "Music" }
  },
  "tasks": [
