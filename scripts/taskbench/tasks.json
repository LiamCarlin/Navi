      "expect": { "commands": 1, "kind": ["task", "open_url"], "surface": ["browser"], "continues": true, "start_hosts": ["doordash.com"] },
      "live": { "skip": true, "why": "only meaningful right after errand-06 on DoorDash" } },
    { "id": "errand-08", "family": "errand", "source": "log 2026-10-29 (ran on the Canvas tab)", "context": "chrome_mcdonalds",
