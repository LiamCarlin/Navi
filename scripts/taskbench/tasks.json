      "utterance": "order me a burger",
      "expect": { "commands": 1, "kind": ["task"], "surface": ["browser"], "current_tab": false,
                  "start_hosts": ["doordash.com", "ubereats.com", "grubhub.com", "mcdonalds.com", "order.online", "google.com/search"],
                  "memory": { "routine": "none" } },
      "live": { "safe_end": "a burger in a delivery cart" } },
    { "id": "errand-06", "family": "errand", "source": "log 2026-10-30 (went to an Amazon product page from screen memory)", "context": "chrome_doordash_store",
