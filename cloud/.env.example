# Navi Cloud — every environment variable it reads. Copy to .env.local for dev.
# With nothing set, the server boots in memory-db + no-vendor mode; add MOCK_UPSTREAM=1
# and DEV_LOGIN_SECRET to run scripts/smoke.sh with no services at all.

# ── Deployment ────────────────────────────────────────────────────────────────
# Public base URL (auth redirects, Stripe return pages). Vercel sets VERCEL_URL automatically.
NAVI_CLOUD_BASE_URL=http://localhost:3100

# ── Supabase (Auth + Postgres) ─────────────────────────────────────────────────
# Leave SUPABASE_URL empty to use the in-memory driver (dev only). DB_DRIVER=memory forces it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → JWT Secret (HS256). Used to verify every bearer token with no network call.
SUPABASE_JWT_SECRET=
# Only for projects on asymmetric signing keys (leave empty otherwise):
SUPABASE_JWKS_URL=
# DB_DRIVER=memory

# Google sign-in is configured inside Supabase (Auth → Providers → Google). These two only
# make the "Continue with Google" button appear on /auth/start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Vendors (server-side only; the app never sees these) ──────────────────────
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional overrides / defaults
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_DIGEST_MODEL=gemini-2.5-flash-lite

# Canned Jev / Claude / Gemini responses (incl. a Claude SSE stream) — no vendor keys needed.
MOCK_UPSTREAM=0

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PRO_RECALL_MONTH=
STRIPE_PRICE_PRO_RECALL_YEAR=

# ── Development only — NEVER set on production ────────────────────────────────
# When set, POST /auth/dev-login {email} (header x-dev-login-secret) issues a session.
DEV_LOGIN_SECRET=
# HS256 secret for tokens minted by the memory driver (defaults to a fixed dev string).
DEV_JWT_SECRET=
